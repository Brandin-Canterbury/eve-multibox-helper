<Window x:Class="EveMultibox.Shell.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phoenix's Eve Helper notifications"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="520"
        Topmost="True" ShowInTaskbar="False"
        Background="#1E1E22" BorderBrush="#44444C" BorderThickness="1" Foreground="#DDDDE4">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Settings/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="Margin" Value="0,14,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Control}" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" FontFamily="Segoe UI Symbol" Padding="10,4"
                        BorderThickness="0" Background="Transparent" Click="Close_Click" ToolTip="Close (Esc)" />
                <TextBlock Text="Notifications" FontWeight="SemiBold" Margin="10,6" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
            <Button DockPanel.Dock="Right" Content="Save" Padding="16,4" Margin="6,0,0,0" Click="Save_Click" IsDefault="True" />
            <Button DockPanel.Dock="Right" Content="Send a test" Margin="6,0,0,0" Click="Test_Click"
                    ToolTip="Shows a sample notification using the settings above (saved or not)." />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
        </DockPanel>

        <StackPanel Margin="12,0,12,0">
            <CheckBox x:Name="EnabledBox" Margin="0,12,0,0" FontWeight="SemiBold"
                      Content="Watch my market orders and show Windows notifications" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,4,0,0"
                       Text="EVE updates a character's order list about every 20 minutes. The helper checks each character right after that update, so a sale can take up to 20 minutes to show. Clicking a notification opens Trade." />

            <TextBlock Text="NOTIFY ME WHEN" Style="{StaticResource Section}" />
            <CheckBox x:Name="FillsBox" Content="An order sells or buys some of its items" />
            <CheckBox x:Name="EndedBox" Margin="0,6,0,0" Content="An order finishes (sold out, filled, expired or cancelled)" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox x:Name="WalletBox" VerticalAlignment="Center" Content="The wallet changes by at least" />
                <TextBox x:Name="MinWalletBox" Width="90" Margin="6,0" ToolTip="ISK, e.g. 1000000 or 1M" />
                <TextBlock Text="ISK" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox x:Name="BalanceBox" Margin="0,6,0,0" Content="Add the new wallet balance to each notification" />

            <TextBlock Text="CHARACTERS" Style="{StaticResource Section}" />
            <ItemsControl x:Name="CharacterList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding NextCheck}" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding Watched}" Content="{Binding Name}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoCharactersText" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="No characters signed in yet. Sign in from Trade → Characters." />

            <TextBlock Text="MESSAGES" Style="{StaticResource Section}" />
            <TextBlock x:Name="TokensText" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Sold" VerticalAlignment="Center" />
                <TextBox x:Name="SoldBox" Grid.Column="1" Margin="0,2" />
                <TextBlock Text="Bought" Grid.Row="1" VerticalAlignment="Center" />
                <TextBox x:Name="BoughtBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                <TextBlock Text="Finished" Grid.Row="2" VerticalAlignment="Center" />
                <TextBox x:Name="EndedBox2" Grid.Row="2" Grid.Column="1" Margin="0,2" />
                <TextBlock Text="Wallet" Grid.Row="3" VerticalAlignment="Center" />
                <TextBox x:Name="WalletTemplateBox" Grid.Row="3" Grid.Column="1" Margin="0,2" />
            </Grid>
            <Button Content="Reset messages to defaults" HorizontalAlignment="Left" Margin="0,6,0,0" Click="ResetTemplates_Click" />
        </StackPanel>
    </DockPanel>
</Window>
