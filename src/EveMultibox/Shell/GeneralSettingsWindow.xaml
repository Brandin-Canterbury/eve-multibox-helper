<Window x:Class="EveMultibox.Shell.GeneralSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Multibox Helper settings"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="480"
        Topmost="True" ShowInTaskbar="False"
        Background="#1E1E22" BorderBrush="#44444C" BorderThickness="1" Foreground="#DDDDE4">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Settings/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                <Setter Property="Margin" Value="0,14,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Control}" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" FontFamily="Segoe UI Symbol" Padding="10,4"
                        BorderThickness="0" Background="Transparent" Click="Close_Click" ToolTip="Close (Esc)" />
                <TextBlock Text="Settings" FontWeight="SemiBold" Margin="10,6" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
            <Button DockPanel.Dock="Right" Content="Save" Padding="16,4" Margin="6,0,0,0" Click="Save_Click" IsDefault="True" />
            <Button DockPanel.Dock="Right" Content="Quit helper" Margin="6,0,0,0" Click="Quit_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
        </DockPanel>

        <StackPanel Margin="12,0,12,0">
            <TextBlock Text="EVE LOGS FOLDER" Style="{StaticResource Section}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Click="Browse_Click" />
                <TextBox x:Name="LogsFolderBox" />
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,4,0,0"
                       Text="Leave blank for Documents\EVE\logs. Used by alerts and to name characters in UI sync." />

            <TextBlock Text="STARTUP" Style="{StaticResource Section}" />
            <CheckBox x:Name="StartWithWindowsBox" Content="Start the helper when Windows starts" />
            <CheckBox x:Name="AutoHideBox" Margin="0,6,0,0"
                      Content="Hide the ☰ button, clients strip and toolbox while no EVE client is running (the tray icon stays)" />

            <TextBlock Text="MENU BUTTON" Style="{StaticResource Section}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reset to bottom-right" Click="ResetMenuButton_Click" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="The ☰ button is locked in place. Hold Alt and drag it to move it." />
            </DockPanel>

            <TextBlock Text="TRADE (EVE SIGN-IN)" Style="{StaticResource Section}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,6">
                One-time setup: create a free app at developers.eveonline.com (Applications → Create).
                Choose "Authentication &amp; API Access", paste the callback URL and scopes below, then paste
                the app's Client ID here. No secret is needed.
            </TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Client ID" VerticalAlignment="Center" />
                <TextBox x:Name="ClientIdBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" />
                <TextBlock Text="Callback port" Grid.Row="1" VerticalAlignment="Center" />
                <TextBox x:Name="CallbackPortBox" Grid.Row="1" Grid.Column="1" Margin="0,2" Width="80" HorizontalAlignment="Left" />
                <TextBlock Text="Callback URL" Grid.Row="2" VerticalAlignment="Center" />
                <TextBlock x:Name="CallbackUrlText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" />
                <Button Content="Copy" Grid.Row="2" Grid.Column="2" Margin="6,2,0,2" Click="CopyCallback_Click" />
                <TextBlock Text="Scopes" Grid.Row="3" VerticalAlignment="Center" />
                <TextBlock Text="9 read/waypoint scopes" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" x:Name="ScopesText" />
                <Button Content="Copy" Grid.Row="3" Grid.Column="2" Margin="6,2,0,2" Click="CopyScopes_Click" />
            </Grid>
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Left" Content="Open developers.eveonline.com" Click="OpenDevSite_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Route search radius" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="JumpRadiusBox" Width="50" />
                    <TextBlock Text="jumps" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="ACTION WIDGET KEYS" Style="{StaticResource Section}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"
                       Text="Must match your bindings in EVE (Esc → Shortcuts → Navigation). Each widget button presses its key once, only in the EVE window you're already in." />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Jump / Dock" VerticalAlignment="Center" Width="80" />
                <TextBox x:Name="JumpKeyBox" Width="90" />
                <TextBlock Text="Undock" VerticalAlignment="Center" Width="60" Margin="20,0,0,0" />
                <TextBox x:Name="UndockKeyBox" Width="90" ToolTip="e.g. Ctrl+U. Leave blank to undock with the station panel instead." />
            </StackPanel>

            <TextBlock Text="ABOUT" Style="{StaticResource Section}" />
            <TextBlock x:Name="AboutText" TextWrapping="Wrap" LineHeight="19" />
        </StackPanel>
    </DockPanel>
</Window>
