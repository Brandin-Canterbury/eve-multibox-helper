<Window x:Class="EveMultibox.Widget.ActionWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE action widget"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="340"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Background="#1E1E22" BorderBrush="#4DA6FF" BorderThickness="1" Foreground="#DDDDE4">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Settings/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>
        <!-- Header: Alt+drag to move (like the ☰ button) so a stray click can't shift it. -->
        <Border Background="{StaticResource Control}" MouseLeftButtonDown="Header_MouseLeftButtonDown"
                ToolTip="Hold Alt and drag to move">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" FontFamily="Segoe UI Symbol" Padding="8,3" Focusable="False"
                        BorderThickness="0" Background="Transparent" Click="Cancel_Click" ToolTip="Stop this plan" />
                <TextBlock x:Name="PlanText" Margin="10,5" FontSize="11" Foreground="{StaticResource TextDim}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <StackPanel Margin="12,10,12,12">
            <TextBlock x:Name="StepTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="InfoText" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="InstructionText" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{StaticResource TextDim}" />
            <StackPanel x:Name="ActionButtons" />
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Content="◀ Back" Focusable="False" Padding="8,4" Click="Back_Click" />
                <Button x:Name="DoneButton" DockPanel.Dock="Right" Focusable="False" Padding="14,6" FontWeight="SemiBold"
                        BorderBrush="{StaticResource Accent}" Click="Done_Click" />
                <TextBlock />
            </DockPanel>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" />
        </StackPanel>
    </StackPanel>
</Window>
