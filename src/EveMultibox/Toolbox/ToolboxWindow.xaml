<Window x:Class="EveMultibox.Toolbox.ToolboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE toolbox"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Background="#1E1E22" MinWidth="220" MaxWidth="320">
    <Window.Resources>
        <Style x:Key="FavButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="#EEE" />
            <Setter Property="Background" Value="#2D2D33" />
            <Setter Property="BorderBrush" Value="#44444C" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A44" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#50505C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- The header always says where a click will go, in that client's color. -->
        <Border x:Name="Header" DockPanel.Dock="Top" Padding="10,6" Cursor="SizeAll"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel>
                <TextBlock x:Name="HeaderCaption" Text="SENDING TO" FontSize="10" FontWeight="SemiBold" Opacity="0.8" />
                <TextBlock x:Name="HeaderTarget" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HeaderCharacter" FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="8,5" Background="#26262C">
            <TextBlock x:Name="StatusText" Foreground="#AAA" FontSize="11" TextWrapping="Wrap"
                       Text="Click an EVE client, then a button." />
        </Border>
        <StackPanel x:Name="Buttons" Margin="2,6" />
    </DockPanel>
</Window>
