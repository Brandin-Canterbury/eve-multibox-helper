<Window x:Class="EveMultibox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:util="clr-namespace:EveMultibox.Util"
        Title="EVE Multibox Helper" Width="900" Height="600" MinWidth="560" MinHeight="400">
    <Window.Resources>
        <util:HexToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Save &amp; apply" Padding="16,5" Click="Save_Click" IsDefault="True" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#555" />
        </DockPanel>

        <TabControl>
            <TabItem Header="Clients">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
                        Characters appear here the first time their client is seen. Give each one a short role label
                        (e.g. MINER 2) and a color you'll recognise at a glance. Focus hotkeys only switch windows,
                        so pick combinations EVE doesn't use, like Ctrl+Alt+1.
                    </TextBlock>
                    <DataGrid x:Name="ClientsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="28" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="16" Height="16" CornerRadius="3" Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Character" Binding="{Binding CharacterName}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Color (#RRGGBB)" Binding="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                            <DataGridTextColumn Header="Focus hotkey" Binding="{Binding FocusHotkey, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Favorites">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
                        Each button sends one EVE shortcut to the client you're working in. The keys must match your
                        bindings in EVE (Esc → Shortcuts). Examples: F1, Alt+F1, Ctrl+Space. Leave Character blank to
                        show a button for everyone, or enter a character name to show it only for that client.
                    </TextBlock>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add" Padding="12,3" Click="AddFavorite_Click" />
                        <Button Content="Remove" Padding="12,3" Margin="6,0,0,0" Click="RemoveFavorite_Click" />
                        <Button Content="Move up" Padding="12,3" Margin="6,0,0,0" Click="MoveUp_Click" />
                        <Button Content="Move down" Padding="12,3" Margin="6,0,0,0" Click="MoveDown_Click" />
                    </StackPanel>
                    <DataGrid x:Name="FavoritesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Button name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Keys" Binding="{Binding Keys, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                            <DataGridCheckBoxColumn Header="Valid" Binding="{Binding IsValid, Mode=OneWay}" IsReadOnly="True" Width="50" />
                            <DataGridTextColumn Header="Character (blank = all)" Binding="{Binding Character, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Alerts">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            Watches EVE's game and chat logs and alerts you with a sound and a flashing thumbnail. The alert
                            clears when you switch to that client. Alerts never send anything to the game.
                        </TextBlock>
                        <CheckBox x:Name="AlertsEnabledBox" Content="Watch EVE logs for alerts" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Logs folder" VerticalAlignment="Center" />
                            <TextBox x:Name="LogsFolderBox" Grid.Column="1" Margin="0,2" ToolTip="Leave blank for Documents\EVE\logs" />
                            <TextBlock Text="Jump-to-alert hotkey" Grid.Row="1" VerticalAlignment="Center" />
                            <TextBox x:Name="JumpHotkeyBox" Grid.Row="1" Grid.Column="1" Margin="0,2" Width="160" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#666" Margin="0,6,0,0">
                        Chat logs record messages only, not who joins Local, so "neutral in Local" can't be detected from logs.
                        Use an intel channel rule with your system names instead. Chat rules need EVE's "Log chat to file"
                        setting turned on. Patterns are case-insensitive regular expressions matched against the line text.
                    </TextBlock>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add rule" Padding="12,3" Click="AddRule_Click" />
                        <Button Content="Remove" Padding="12,3" Margin="6,0,0,0" Click="RemoveRule_Click" />
                        <Button Content="Add missing defaults" Padding="12,3" Margin="6,0,0,0" Click="DefaultRules_Click" />
                    </StackPanel>
                    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="34" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                            <DataGridComboBoxColumn x:Name="RuleSourceColumn" Header="Log" SelectedItemBinding="{Binding Source}" Width="60" />
                            <DataGridTextColumn Header="Line type" Binding="{Binding LineType, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Channel" Binding="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*" FontFamily="Consolas" />
                            <DataGridTextColumn Header="Cooldown s" Binding="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Width="74" />
                            <DataGridCheckBoxColumn Header="Sound" Binding="{Binding Sound, UpdateSourceTrigger=PropertyChanged}" Width="46" />
                            <DataGridCheckBoxColumn Header="Valid" Binding="{Binding IsValid, Mode=OneWay}" IsReadOnly="True" Width="40" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="UI sync">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            Copy one character's EVE window layout, overview and UI settings to your other characters, so every
                            client looks the same. <Bold>Close all EVE clients first</Bold>: EVE saves settings when it closes and
                            would undo the copy. Every file is backed up before it's overwritten.
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="EVE settings folder" VerticalAlignment="Center" />
                            <ComboBox x:Name="ProfileBox" Grid.Column="1" Margin="0,2" SelectionChanged="ProfileBox_SelectionChanged" />
                            <Button Content="Refresh" Grid.Column="2" Padding="10,2" Margin="6,2,0,2" Click="RefreshSync_Click" />
                            <TextBlock Text="Copy character settings from" Grid.Row="1" VerticalAlignment="Center" />
                            <ComboBox x:Name="CharSourceBox" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                            <TextBlock Text="Copy account settings from" Grid.Row="2" VerticalAlignment="Center"
                                       ToolTip="Account files hold settings shared by all characters on one account. Optional." />
                            <ComboBox x:Name="AcctSourceBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />
                        </Grid>
                        <TextBlock Text="Tick the files to overwrite:" Margin="0,8,0,4" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Copy to ticked files" Padding="12,3" Click="CopySettings_Click" />
                        <Button Content="Restore last backup" Padding="12,3" Margin="6,0,0,0" Click="RestoreBackup_Click" />
                        <Button Content="Open backups folder" Padding="12,3" Margin="6,0,0,0" Click="OpenBackups_Click" />
                    </StackPanel>
                    <DataGrid x:Name="SyncGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Overwrite" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Type" Binding="{Binding KindText}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="100" />
                            <DataGridTextColumn Header="Last changed" Binding="{Binding LastWrite, StringFormat=g}" IsReadOnly="True" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Display">
                <StackPanel Margin="12">
                    <CheckBox x:Name="ShowOverlaysBox" Content="Colored border and label on each EVE window" Margin="0,4" />
                    <CheckBox x:Name="ShowThumbnailsBox" Content="Thumbnail switcher" Margin="0,4" />
                    <CheckBox x:Name="ShowToolboxBox" Content="Favorites toolbox" Margin="0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Thumbnail width" VerticalAlignment="Center" Width="120" />
                        <Slider x:Name="ThumbWidthSlider" Minimum="120" Maximum="480" Width="240" TickFrequency="20" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding Value, ElementName=ThumbWidthSlider}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Detection">
                <StackPanel Margin="12">
                    <TextBlock Text="Process names (comma separated)" />
                    <TextBox x:Name="ProcessNamesBox" Margin="0,2,0,10" />
                    <TextBlock Text="Window title pattern (regex with a (?&lt;name&gt;...) group)" />
                    <TextBox x:Name="TitleRegexBox" Margin="0,2,0,10" FontFamily="Consolas" />
                    <CheckBox x:Name="IncludeLoginBox" Content="Also show clients at the login / character select screen" />
                    <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#666">
                        The defaults (exefile, ^EVE - (?&lt;name&gt;.+)$) match the EVE client. To try the tool without EVE,
                        use process "notepad" and pattern ^(?&lt;name&gt;.+) - Notepad$, then open a few Notepad windows.
                    </TextBlock>
                </StackPanel>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                    <TextBlock TextWrapping="Wrap" LineHeight="20">
                        <Bold>Staying within EVE's rules</Bold><LineBreak />
                        CCP bans input broadcasting (one input reaching several clients) and multiplexing (one input
                        doing several actions). This tool is built so it can't do either:<LineBreak />
                        • Thumbnails and focus hotkeys only switch windows. They send nothing to the game.<LineBreak />
                        • One toolbox click sends exactly one shortcut, only to the client already in the foreground.
                        If another window is active, nothing is sent.<LineBreak />
                        • No sequences, repeats, timers or log-triggered input exist anywhere in the tool.<LineBreak />
                        • Log alerts only play a sound and flash a thumbnail. The jump-to-alert hotkey only switches windows.<LineBreak /><LineBreak />
                        Settings are stored in %AppData%\EveMultibox\config.json.
                    </TextBlock>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
