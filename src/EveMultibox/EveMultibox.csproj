<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the system tray icon (NotifyIcon); everything else is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>EveMultibox</AssemblyName>
    <Product>EVE Multibox Helper</Product>
    <!-- Major.minor; releases add the build number as the patch (see .github/workflows/release.yml). -->
    <Version>0.3.0</Version>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 produces a single self-contained exe -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Release builds (dotnet publish -p:ReleaseChannel=github, done by the release workflow) can update
       themselves; development builds can't, so a copy run from a build folder is never replaced. -->
  <ItemGroup Condition="'$(ReleaseChannel)' != ''">
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EveMultibox.Tests" />
    <!-- Keep WinForms out of the global usings so names like Application and MessageBox stay WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
