<Window x:Class="EveMultibox.Overlay.BorderOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE client border"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False"
        Width="200" Height="200">
    <Grid>
        <Border x:Name="Frame" BorderThickness="3" />
        <Border x:Name="LabelPill" HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="0,0,8,8" Padding="14,2,14,4">
            <TextBlock x:Name="LabelText" FontSize="16" FontWeight="Bold" />
        </Border>
    </Grid>
</Window>
